{
  "name": "alumni-portal",
  "version": "1.0.0",
  "description": "Comprehensive Alumni Profile Management Website",
  "scripts": {
    "install-all": "npm install && cd alumni-frontend && npm install && cd ../server && npm install",
    "start": "concurrently \"cd server && npm run dev\" \"cd alumni-frontend && npm run dev\"",
    "server": "cd server && npm run dev",
    "client": "cd alumni-frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.13.1",
    "morgan": "^1.10.0",
    "winston": "^3.17.0"
  }
}
